# Kronos workspace monorepo — root ignore rules.
# Per-directory .gitignore files (KronosStrategies/, Kronos_Backend/, kronos_frontend/,
# ClaudeTradingRD/) still apply inside their folders; this file covers what is
# cross-cutting or lives at the root.

# ── Secrets — never commit ──────────────────────────────────────────────────
.env
.env.*
**/.env
**/.env.*
.env_aws
*.pem
account*.txt
*.session
.mt5_cred
telegram_channel_ids
**/.claude/settings.local.json
**/.claude/scheduled_tasks.lock

# ── Libraries / dependency trees (rebuildable) ──────────────────────────────
.venv/
**/.venv/
venv/
node_modules/
**/node_modules/

# ── Build output / caches ───────────────────────────────────────────────────
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
**/.next/
**/out/
**/build/
*.tsbuildinfo
.netlify/
.superpowers/
.playwright-mcp/
kb/chroma/
~/.cache/

# ── IDE / OS ────────────────────────────────────────────────────────────────
.idea/
.vscode/
.DS_Store
*.tmp.*

# ── Large local data (regenerable; see per-repo READMEs) ────────────────────
.history_data/
