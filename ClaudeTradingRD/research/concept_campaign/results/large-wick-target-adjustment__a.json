 "operationalization": {
  "rules": [
   "entry: 1h CISD (series_open, 2/2 swings, max_wait 3, min_series 1), decide at the confirming 1h close, enter next M1 open, stop at the protected swing, hold 10h",
   "running daily candle at the decision (18:00 NY trading day, M1 bars closed by then): O = first M1 open in 18:00-19:00 NY, H/L = running high/low, P = confirm close",
   "large wick = opposing run (O-L long, H-O short) > 1.0 x max(direction*(P-O), 0)",
   "target = previous trading day's high (long) / low (short), kept only if beyond P",
   "gate = large wick; claim '-': large-wick trades aimed at the expansion target do worse (control-adjusted) than small-wick ones"
  ],
  "params": {
   "entry_tf": "1h",
   "max_hold": "10h",
