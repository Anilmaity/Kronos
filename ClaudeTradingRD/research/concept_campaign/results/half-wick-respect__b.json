{
 "concept_id": "half-wick-respect",
 "reading": "b",
 "testable": true,
 "test_type": "gate",
 "claim": "+",
 "operationalization": {
  "rules": [
   "C1 = 4H candle (forex grid) whose lower wick exceeds its body and its upper wick (bullish reversal candle; mirror bearish); half = body edge -/+ 0.5 x wick",
   "C2 = next 4H candle; test bar = first complete 1h bar inside C2 that trades into the wick (beyond the body edge) while C1's extreme is intact",
   "decide at the test bar's close; trade C1's reversal direction at the next M1 open, stop = C1's wick extreme, 2.0R, exit after 240min of trading time",
   "gate: the test bar's low (high) stays at/above (below) the half level"
  ],
  "params": {
   "htf": "4h",
   "grid4h": "forex",
   "ltf": "1h",
   "reversal_candle": "wick > body and > other wick",
   "rr": 2.0,
   "max_hold": "240min",
   "hold_basis": "bars",
   "respect": "resp_touch"
  }
 },
 "params_source": {
  "htf": "corpus yaml timeframes htf 1D/4H/1H; threshold_fits \u00a71 wick effects live on 4h/1D",
  "grid4h": "session_window_fit: forex grid for gold (weak; recorded)",
  "ltf": "corpus yaml timeframes: the next period is read on a lower timeframe (15m/5m listed; 1h is the 4H's hourly CISD layer, method_spec \u00a72.4)",
  "reversal_candle": "threshold_fits: large wick / reversal candle = opposing run > body (grade A); corpus TND1aTpnq5c 'the wick is larger than the body'",
  "rr": "corpus yaml execution targets: '2R'",
  "max_hold": "declared-before-run: one 4H period",
  "hold_basis": "declared-before-run: trading time (the 17:00 grid candle spans the halt)",
  "respect": "corpus yaml: 'on the following period price should open, form a low at or above that level'"
