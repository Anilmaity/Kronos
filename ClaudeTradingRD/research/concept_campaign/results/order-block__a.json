 "claim": "+",
 "operationalization": {
  "rules": [
   "1h bars; 2/2 swing extreme that exceeds the most recent swing confirmed before it (raid of a short-term high/low)",
   "block = the contiguous opposing-close run (<= 10 candles) into that extreme (detectors.cisd run)",
   "validation = a close through the run's extreme (low of up-close / high of down-close run) within 3 bars of the run end / swing confirmation",
   "entry = first M1 retest of the block's opening price (open of the first run candle) within 24 x 1h after the validating close, cancelled if price trades beyond the extreme first; decide at that M1 close",
   "stop = the extreme; 2R; hold 10h"
  ],
  "params": {
   "tf": "1h",
   "swing": "2/2",
   "max_wait": 3,
   "level_rule": "series_extreme",
   "level": "block open",
   "wait_h": 24,
   "rr": 2.0,
   "max_hold": "10h",
   "raid": "swept last confirmed swing"
  }
 },
