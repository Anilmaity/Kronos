   "null = random 5m closes +/-30d, same ATR-unit distance from next M1 open, same side"
  ],
  "params": {
   "tf": "5min",
   "swing": "2/2",
   "eq_tol_atr": 0.1,
   "eq_lookback_bars": 48,
   "horizon_m1_bars": 240,
   "atr_n": 14,
   "null": "ATR-scaled distance"
  }
 },
