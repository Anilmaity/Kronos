  "rules": [
   "1h UTC bars; live expansion = latest 1h expansion event (close beyond 2/2 swing, 4-bar window range/pre-range >= 1.5, distance/pre-range >= 0.65) decided 1..24 bars before, its origin not traded through since",
   "at the close of each qualifying opposing candle (bull leg: down-close with close > low; mirror) enter with the trend at the next M1 open",
   "stop = extreme of the contiguous opposing series ending at that candle; target = the leg's extreme since the expansion's break; 10h trading time; NY clock +/-30 min control; clustered by expansion leg"
  ],
  "params": {
   "tf": "1h",
   "exp_n": 4,
   "exp_r": 1.5,
   "exp_d": 0.65,
   "max_age": 24,
