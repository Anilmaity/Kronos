 "claim": "+",
 "operationalization": {
  "rules": [
   "bias: daily C2 or C3 (C2-open reference) closure + same-direction 1h CISD inside that day (series_open, scope range) -> bias for the next session",
   "baseline: next session, every 1h close with NY close time in 03:00-12:00; direction = bias; stop = day's running opposite extreme; target = prior day's bias-side extreme; exit 17:00 NY; drop rows where the target was already reached, target not beyond price, or stop distance < 0.10 x prior-day range",
   "gate bias_intact: no 1h close since the 18:00 NY day open (through the decision bar) beyond the day open against the bias (bearish: close > open invalidates; mirror bullish); once invalidated, stays invalid for the day"
  ],
  "params": {
   "window": "03:00-12:00 NY (1h closes)",
   "min_risk_frac": 0.1,
   "stub_filter_min_m1": 600,
   "cisd_scope": "range",
   "c3_reference": "c2_open",
   "day_open": "18:00 NY",
   "closure_tf": "1h",
   "invalidation_persistence": "rest of day",
   "symmetric": true
  }
 },
 "params_source": {
  "window": "corpus: daily-profile-session-windows London 02:00-05:00 / NY a.m. 08:30-12:00 (method_spec \u00a72.5); same baseline as daily-profile-confirmation",
