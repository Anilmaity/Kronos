 "claim": "+",
 "operationalization": {
  "rules": [
   "baseline: 15m bare CISD (series_open, 2/2 swings, max_wait 3), decided at the confirming 15m bar's close, next-M1-open entry, stop at the protected swing, 2R, 150-min clock hold",
   "one position at a time: a signal is skipped while the previous taken trade is open (exit known at the close of its M1 exit bar, resolved with the harness resolver)",
   "daily limits: step away for the rest of the trading day once realised R today <= -2.0 or >= +4.0",
   "streak limits: step away for the rest of the day after 3 consecutive losses or 3 consecutive wins (counters reset at each step-away)",
   "weekly limits: step away for the rest of the trading week once realised R this week <= -5.0 or >= +10.0",
   "tallies count only trades taken under the rules; gate allowed = no limit active; complement = the trades a limit-breaker would have taken"
  ],
  "params": {
   "baseline_tf": "15min",
   "level_rule": "series_open",
   "swing": "2/2",
   "max_wait": 3,
   "min_series": 1,
   "rr": 2.0,
   "max_hold": "150min",
   "sequencing": "one position at a time",
   "day_loss_R": -2.0,
   "day_gain_R": 4.0,
   "streak_n": 3,
   "week_loss_R": -5.0,
   "week_gain_R": 10.0,
   "ctrl_tod_tol_min": 30
  }
 },
