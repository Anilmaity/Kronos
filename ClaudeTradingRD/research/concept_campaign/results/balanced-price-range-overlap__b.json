 "operationalization": {
  "rules": [
   "15m three-bar FVGs known at the third bar's close",
   "BPR = a new FVG overlapping an opposing FVG formed <= 20 bars earlier; zone = intersection; direction = the later gap",
   "stop = the extreme between the two gaps (the first aggressive move's extreme)",
   "entry: first M1 touch of the zone's near edge within 24h; next M1 open; skip if the touch minute also hits the stop; 2R; hold 150 min",
   "gate: long BPR with zone midpoint below the previous day's EQ, short above (premium/discount rule); gated vs complement"
  ],
  "params": {
   "tf": "15min",
   "pair_bars": 20,
   "window": "24h",
   "rr": 2.0,
   "max_hold": "150min",
   "eq_range": "previous trading day (18:00 NY roll)"
  }
 },
