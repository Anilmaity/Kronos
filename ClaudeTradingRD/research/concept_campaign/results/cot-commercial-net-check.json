 "operationalization": {
  "rules": [
   "COMEX gold COT (CFTC legacy futures-only, code 088691), commercial net = long - short",
   "at each quarter start: reports with as-of <= quarter start - 10d; last 52 weeks; midpoint = (max+min)/2; latest net > midpoint -> bullish quarter else bearish",
   "baseline: every trading day a long AND a short row at the prior daily close, stop 1.0 x ATR14(1D), target 2R, hold 1380 M1 bars (one trading day)",
   "gate: row direction == quarter's COT reading; clustered by quarter"
  ],
  "params": {
   "lag_days": 10,
   "window": "52 weeks",
   "atr_n": 14,
   "stop_atr": 1.0,
   "rr": 2.0,
   "max_hold": "1380min",
   "hold_basis": "bars",
   "contract": "088691 COMEX gold, legacy futures-only"
  }
 },
 "params_source": {
  "lag_days": "declared-before-run: CFTC publishes Tuesday data on Friday; 10 days covers the Dec-2018 shutdown delay",
