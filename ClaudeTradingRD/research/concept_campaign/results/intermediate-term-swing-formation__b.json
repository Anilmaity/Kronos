 "claim": "+",
 "operationalization": {
  "rules": [
   "baseline: first 5m close through a confirmed three-candle short-term low (high) formed within the current + previous two 1h candles; trade the break (short a low break, long a high break)",
   "decide at the breaking 5m bar's close, enter next M1 open; stop at the extreme since the swing (max high / min low from the swing bar to the break bar); 2R; 50 min wall clock",
   "gate: the broken swing is a 'rebalanced' intermediate-term swing \u2014 its low printed inside a bullish FVG (high inside a bearish FVG) formed within the prior 36 5m bars and not reached before",
   "claim: breaks of intermediate-term swings continue better than breaks of ordinary short-term swings (control-adjusted R)"
  ],
  "params": {
   "tf": "5min",
   "swing": "1/1 fractal",
   "win_h": 3,
   "rr": 2.0,
   "max_hold": "50min",
   "fvg_lookback": 36,
   "fvg_reach": "extreme inside [gap_low, gap_high], first reach"
  }
 },
 "params_source": {
  "tf": "corpus: yaml timeframes ltf 5m (d0x29IO1CQQ diagram generic; 5m is the stated ltf)",
  "swing": "corpus: d0x29IO1CQQ 'A short-term low is when we form a swing low' (a low with a higher low on each side)",
  "win_h": "corpus: HbOeD_JVens three-HTF-candle look-back applied to the 5m -> 1h pairing (method_spec \u00a71.2)",
  "rr": "phase3: 2R rung-0 target",
