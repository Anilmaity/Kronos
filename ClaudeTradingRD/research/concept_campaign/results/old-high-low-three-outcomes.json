 "claim": "+",
 "operationalization": {
  "rules": [
   "old high/low = previous trading day's high/low (18:00 NY roll), read at the 15m bar start; first interaction per level per day, the bar must open back inside",
   "displacement = a 15m close beyond the level",
   "branch 3 (no close beyond) -> fade at that close, stop = the bar's extreme",
   "branch 2 (close beyond, then a close back inside within 3 bars) -> fade at that close, stop = extreme since the break",
   "branch 1 (close beyond, no close back inside for 3 bars) -> continue at the 3rd bar's close, stop = the retracement extreme of those bars",
   "2R, hold 150 min, next M1 open"
  ],
  "params": {
   "tf": "15min",
   "k_bars": 3,
   "level": "PDH/PDL",
   "rr": 2.0,
   "max_hold": "150min",
   "displacement": "close beyond"
  }
 },
