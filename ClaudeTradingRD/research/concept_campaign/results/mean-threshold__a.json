 "operationalization": {
  "rules": [
   "1h bars; CISD = close through the open of the first candle of the opposing-close series after a 2/2 fractal swing, within 3 bars (phase-3 rung 0)",
   "order block = that series; body_high/body_low over ALL candles of the series; MT = (body_high + body_low)/2",
   "limit at MT resting from the CISD close for 10 bars; fill = first M1 bar whose low<=MT (longs) / high>=MT (shorts); decide at that M1 bar's close, enter next M1 open",
   "stop at the protected swing (unchanged); target 2R from the actual entry; exit after 10h",
   "CISD events where the confirm close is not beyond MT or MT is not beyond the swing are skipped"
  ],
