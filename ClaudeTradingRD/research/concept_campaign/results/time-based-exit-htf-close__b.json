 "operationalization": {
  "rules": [
   "the 15m candle opening 09:30 NY; expansion = body != 0 and opposing run / |body| <= 1.0",
   "decide at its close (09:45); enter next M1 open in its direction; stop = its opposing extreme; target = previous trading day's high/low (18:00 roll, min_coverage 0.5) if untaken and beyond the 09:45 close, else none",
   "each entry twice: exit at 10:00 NY (15 min, gated) vs hold to 12:00 NY (135 min, complement); same stop/target; controls share each row's hold at the same NY clock +/-30 min"
  ],
  "params": {
   "wick_cut": 1.0,
   "entry_candle": "15m @ 09:30 NY",
   "target": "untaken PDH/PDL",
   "exit_10": "15min",
   "hold_alt": "135min (to 12:00)",
   "ctrl_tod_tol_min": 30
  }
 },
