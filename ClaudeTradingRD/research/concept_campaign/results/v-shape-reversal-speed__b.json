 "test_type": "gate",
 "claim": "+",
 "operationalization": {
  "rules": [
   "15min bars; extreme = bar whose low (high) is below (above) the 2 prior bars AND the lowest low (highest high) of the prior 20 bars (POI: short-term range liquidity taken)",
   "opposing series = contiguous down-close (up-close) candles ending at the extreme (or <=2 bars before it), <=10 long; level = OPEN of its first candle",
   "closure = first close beyond the level within 10 candles after the extreme, no new extreme before it; decide at that close, enter next M1 open",
   "stop = the extreme (protected swing), target 2.0R, exit after 150min",
   "gate: k <= approach (length of the opposing series into the extreme)"
  ],
  "params": {
   "tf": "15min",
   "poi_lookback": 20,
   "left": 2,
   "max_k": 10,
   "rr": 2.0,
   "max_hold": "150min",
   "level": "series first-candle open",
   "relative": "k <= approach"
  }
 },
