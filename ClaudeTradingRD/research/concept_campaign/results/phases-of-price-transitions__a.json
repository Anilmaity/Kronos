 "operationalization": {
  "rules": [
   "15m UTC-aligned bars; expansion event = close beyond a confirmed 2/2 swing, then the 4-bar window from the break has range/pre-range >= 1.5 and distance-beyond/pre-range >= 0.65; decided at the 4th window bar's close",
   "E2 = next expansion event after E1, opposite direction, break bar 1..24 bars after E1's decision bar (expansion met with opposing expansion = reversal)",
   "enter E2's direction at next M1 open after E2's decision; stop = E1's extreme from its break to E2's decision; target = E1's origin (the extreme behind its move)",
   "exit after 12h of trading time (720 M1 bars); control holds NY clock +/-30 min"
  ],
  "params": {
   "tf": "15min",
   "exp_n": 4,
   "exp_r": 1.5,
   "exp_d": 0.65,
   "swing": "2/2",
   "k_bars": 24,
   "max_hold": "12h",
   "hold_basis": "bars",
   "ctrl_tod_tol_min": 30,
   "cluster": "E1"
  }
 },
