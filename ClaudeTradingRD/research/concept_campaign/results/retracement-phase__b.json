 "testable": true,
 "test_type": "trade",
 "claim": "+",
 "operationalization": {
  "rules": [
   "1h expansion event (close beyond 2/2 swing; 4-bar window range/pre-range >= 1.5, distance/pre-range >= 0.65) = the trend leg; origin O = extreme behind the move",
   "15m phase-3 CISD in the leg's direction whose extreme L prints after the expansion was decided; H = furthest 15m extreme from the expansion's break to L",
   "shallow: (H-L)/(H-O) <= 0.50; drop rows where H was traded through before the CISD close",
   "quick: time(H->L) < time(O->H)",
   "enter next M1 open after the CISD close; stop L; target H; 8h trading-time hold; control holds NY clock +/-30 min"
  ],
  "params": {
   "trend_tf": "1h",
   "entry_tf": "15min",
   "exp_n": 4,
   "exp_r": 1.5,
   "exp_d": 0.65,
   "shallow": 0.5,
   "cisd": "series_open/2-2/mw3",
   "stop": "L",
   "target": "H",
   "slow_vs_quick": "quick",
   "max_hold": "8h",
   "hold_basis": "bars",
   "ctrl_tod_tol_min": 30,
   "cluster": "expansion leg"
  }
 },
 "params_source": {
