 "operationalization": {
  "rules": [
   "15m bars. Smart money reversal = CISD (close through the opening price of the opposing-candle series into a 2/2 swing, within 3 bars)",
   "prior leg (bullish case) = latest 2/2 swing high before the reversal low to that low; old gaps = bearish FVGs stamped in that leg",
   "a gap is carried across the curve once a candle after the low CLOSES above its top (within 16 bars of the CISD)",
   "entry: limit at the gap top, first M1 retest after the later of that close and the CISD close, live 16 bars; decide at that M1 close",
   "stop at the reversal extreme (protected swing); target 2R; exit 150 min; bearish mirrors"
  ],
  "params": {
   "tf": "15min",
   "cisd_level_rule": "series_open",
   "swing": "2/2",
   "max_wait": 3,
   "close_bars": 16,
