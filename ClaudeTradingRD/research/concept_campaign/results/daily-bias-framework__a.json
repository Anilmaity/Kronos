 "operationalization": {
  "rules": [
   "candles: 1D (18:00 NY roll); bias-source candle skipped if it has fewer than the stub-filter M1 bars",
   "previous-candle engine (detectors.bias.previous_candle_state): took one side and closed outside -> same direction; took one side and closed back inside -> opposite; both sides -> no bias; inside bar -> last resolved side (trend); 3 inside bars -> none",
   "decide at the biased candle's close_time; enter next M1 open in the bias direction",
   "target = that candle's bias-side extreme (high if bullish), stop = its opposite extreme",
   "time exit after 1380min of trading bars (one candle of the same timeframe)"
  ],
  "params": {
   "timeframe": "1D (18:00 NY roll)",
   "stub_filter_min_m1": 600,
   "range_lookback": 3,
   "max_hold": "1380min",
