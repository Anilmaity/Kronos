{
 "concept_id": "reversal-signature",
 "reading": "b",
 "testable": true,
 "test_type": "trade",
 "claim": "+",
 "operationalization": {
  "rules": [
   "1h extreme = bar below its 2 prior lows and the lowest low of the prior 20 bars (mirror for highs) that trades beyond the previous trading day's low/high (18:00 NY day, coverage >= 0.5) or the previous week's low/high",
   "expansion away = close beyond the OPEN of the first candle of the opposing series into the extreme within 3 candles of the extreme, no new extreme first",
   "decide at that close, enter next M1 open away from the extreme, stop = extreme, 2.0R, exit after 10h",
   "SMT: XAG_USD H1 has NOT traded beyond its own counterpart (previous trading day / week low for a bullish case) of a level gold took, from the start of the extreme's trading day (week) through the closing candle; events without silver bars at the extreme or closing hour are dropped"
  ],
  "params": {
   "tf": "1h",
   "poi_lookback": 20,
   "max_k": 3,
   "rr": 2.0,
   "max_hold": "10h",
   "levels": "PDH/PDL (min_coverage 0.5) or PWH/PWL",
   "correlate": "XAG_USD H1 (OANDA, m3_scalper/xag_h1_full.parquet)"
  }
 },
 "params_source": {
  "tf": "corpus yaml timeframes: htf 1D/4H, ltf 1H first",
  "poi_lookback": "phase3: lookback 20 knob",
  "max_k": "corpus: PQiRV0JMhIQ 'It only takes a couple candles. Now, I prefer 1 2 maybe three.' (immediately)",
  "rr": "phase3: 2R",
  "max_hold": "phase3: 1h book 10h exit",
  "levels": "corpus: VD4xb9VfMHA 'focus on previous days highs and lows or previous week's highs and lows'",
  "correlate": "method_spec: \u00a72.6 SMT = one shared level, one asset beyond, the other not; silver is the method's sanctioned gold correlate (fetch_correlated.py)"
