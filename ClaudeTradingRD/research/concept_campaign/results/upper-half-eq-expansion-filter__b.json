   "EQ = (prev day high + prev day low) / 2; stop = protected swing; 2R; hold 10h",
   "gate eq_close: close: no 1h close of the day (through the confirming bar) beyond the previous day's EQ against the direction"
  ],
  "params": {
   "htf": "1D",
   "ltf": "1h",
   "rr": 2.0,
