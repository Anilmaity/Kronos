 "operationalization": {
  "rules": [
   "daily candles (18:00 NY roll), wick day >= 600 M1 bars",
   "large upper wick: upper wick > body and > lower wick; band = body top -> high; EQ = midpoint (bullish mirror on the lower wick)",
   "next trading day: first H1 bearish FVG (3 bars inside the day) overlapping [base, EQ], with no H1 close above EQ first",
   "short at next M1 open after the FVG bar close; stop = wick EQ; target = the wick day's low; hold 10h"
  ],
  "params": {
   "wick_rule": "wick > body and wick > other wick",
   "base": "body edge",
   "search": "next trading day",
   "target": "wick day's opposite extreme",
   "max_hold": "10h",
   "min_m1": 600
  }
 },
 "params_source": {
