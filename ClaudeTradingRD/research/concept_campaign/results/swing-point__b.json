 "test_type": "trade",
 "claim": "+",
 "operationalization": {
  "rules": [
   "1h bars; swing low at i := low[i] < low[i-1] and low[i] < low[i+1] (mirror for highs), usable from the close of bar i+1",
   "decide at that close, enter next M1 open away from the swing (long off a swing low, short off a swing high), stop = the swing extreme, 2.0R, exit after 10h",
   "reading b: only swings whose extreme takes out the most recent earlier confirmed same-side swing (a sweep of liquidity)"
  ],
  "params": {
   "tf": "1h",
   "swing": "strict 3-bar",
   "rr": 2.0,
   "max_hold": "10h",
   "sweep_ref": "last confirmed same-side swing"
  }
 },
