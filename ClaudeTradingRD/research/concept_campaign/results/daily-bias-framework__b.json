  "range_lookback": "method_spec: \u00a72.3 range-bound state, detectors.bias default 3",
  "max_hold": "declared-before-run: the bias is for the NEXT candle only (one candle of trading bars)",
  "hold_basis": "declared-before-run: README trap 7 \u2014 daily/4H exits cross the 17:00 halt and weekends",
  "grid4h": "session_window_fit: forex grid for gold (carried as knob per phase3)"
