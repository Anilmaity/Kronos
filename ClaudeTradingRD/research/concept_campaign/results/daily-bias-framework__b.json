 "testable": true,
 "test_type": "trade",
 "claim": "+",
 "operationalization": {
  "rules": [
   "candles: 4h forex grid; bias-source candle skipped if it has fewer than the stub-filter M1 bars",
   "previous-candle engine (detectors.bias.previous_candle_state): took one side and closed outside -> same direction; took one side and closed back inside -> opposite; both sides -> no bias; inside bar -> last resolved side (trend); 3 inside bars -> none",
   "decide at the biased candle's close_time; enter next M1 open in the bias direction",
   "target = that candle's bias-side extreme (high if bullish), stop = its opposite extreme",
   "time exit after 240min of trading bars (one candle of the same timeframe)"
  ],
  "params": {
   "timeframe": "4h forex grid",
   "stub_filter_min_m1": 60,
   "range_lookback": 3,
   "max_hold": "240min",
   "hold_basis": "bars",
   "grid4h": "forex"
  }
 },
 "params_source": {
  "timeframe": "corpus: daily-bias-framework definition 'read off a single daily closure' (a) / 'He runs this candle-by-candle on the 4-hour' (b)",
