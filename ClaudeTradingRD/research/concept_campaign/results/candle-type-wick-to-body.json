 "claim": "+",
 "operationalization": {
  "rules": [
   "4h candles (forex grid 17/21/01/05/09/13 NY) with >= 120 M1 bars and a non-zero body",
   "direction = sign(close - open); decide at the candle close, enter next M1 open",
   "stop = 1 x ATR(20) of 4h bars known at the close; target = 1 x ATR (rr 1); hold 3 candles = 720 trading minutes",
   "gate body_ge_wick: opposing run (bullish: open - low; bearish: high - open) <= |close - open|; complement = reversal candle (wick larger than the body)"
  ],
  "params": {
   "tf": "4h",
   "grid4h": "forex",
   "atr_n": 20,
   "k_atr": 1.0,
   "rr": 1.0,
   "max_hold": "720min",
   "hold_basis": "bars",
   "min_m1": 120,
   "wick_body_cut": 1.0
  }
 },
