 "test_type": "trade",
 "claim": "+",
 "operationalization": {
  "rules": [
   "15min bars. OB1 = down-close series (<=10) into a 2/2 swing low, closed over (close > series first open) within 3 bars after the swing confirms (phase-3 CISD); zone = series bodies",
   "price trades back into OB1 (low <= OB1 top) within 20 bars, no close below OB1 body bottom",
   "OB2 = down-close series ending at the retracement low (new lower low resets); a close above OB2's first open within 20 bars = propulsion block",
   "entry: first M1 bar within 150 M1 bars of the PB close whose low reaches the PB opening price; decide at that M1 close (must be above the stop), enter next M1 open; target 2R; exit after 150min; bearish mirrored",
   "stop = the propulsion block's LOW (lowest low of the series to the retracement low)"
  ],
  "params": {
   "tf": "15min",
   "swing": "2/2",
   "max_wait": 3,
   "retrace_window": 20,
   "pb_window": 20,
   "fill_window_m1": 150,
   "max_series": 10,
   "rr": 2.0,
   "max_hold": "150min",
   "stop": "low"
  }
 },
