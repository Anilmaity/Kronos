 "claim": "+",
 "operationalization": {
  "rules": [
   "1h extreme = bar below its 2 prior lows and the lowest low of the prior 20 bars (mirror for highs) that trades beyond the previous trading day's low/high (18:00 NY day, coverage >= 0.5) or the previous week's low/high",
   "expansion away = close beyond the OPEN of the first candle of the opposing series into the extreme within 3 candles of the extreme, no new extreme first",
   "decide at that close, enter next M1 open away from the extreme, stop = extreme, 2.0R, exit after 10h"
  ],
  "params": {
   "tf": "1h",
   "poi_lookback": 20,
   "max_k": 3,
   "rr": 2.0,
   "max_hold": "10h",
   "levels": "PDH/PDL (min_coverage 0.5) or PWH/PWL"
  }
 },
