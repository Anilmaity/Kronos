 "operationalization": {
  "rules": [
   "short: 15m bearish CISD whose swing extreme (same trading day) is above the previous day's high; long mirrored on PDL",
   "SMT: silver's 1h bars of the same trading day closed by the decision did not take silver's own PDH (PDL for longs)",
   "short only if the CISD close is above the midnight open (long: below); no trade before midnight",
   "target = top (bottom) edge of the nearest unmitigated 1h bullish (bearish) FVG below (above) the entry, formed within 120 hourly bars; none -> no trade",
   "stop at the raid extreme; exit after 150 min"
  ],
  "params": {
   "tf": "15min",
   "raid": "PDH/PDL (prior_hilo, min_coverage 0.5)",
   "mss": "15m CISD series_open 2/2 max_wait 3",
   "smt": "silver 1h, PDH/PDL held",
   "midnight_filter": true,
   "target": "nearest unmitigated 1h FVG edge",
   "hfvg_lookback": 120,
   "max_hold": "150min"
  }
 },
