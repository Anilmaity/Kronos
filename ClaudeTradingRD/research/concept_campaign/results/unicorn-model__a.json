   "fvg_window": "after L2 to one bar after the break",
   "overlap": "any",
   "limit": "top of overlap",
   "fill_wait": "60min",
   "stop": "swept extreme L2",
   "rr": 2.0,
   "max_hold": "50min"
  }
 },
