 "operationalization": {
  "rules": [
   "4h candles (forex 4h grid / NY 18:00 day); 15min CISD = phase-3 rung 0 (series_open, 2/2, max_wait 3)",
   "keep CISDs whose swing-extreme bar and confirming bar lie in the same HTF candle and whose protected swing equals that candle's running extreme (M1) at the confirming close",
   "decide at the CISD close; enter next M1 open; stop = the extreme; target 2R; hold 10 LTF bars",
   "gate trusted = early (M1 minute of the extreme <= 0.25 of the HTF period) AND shallow (HTF open -> extreme <= 0.3 x previous HTF candle range)"
  ],
  "params": {
   "htf": "4h",
   "ltf": "15min",
   "early": 0.25,
   "shallow": 0.3,
   "rr": 2.0,
   "max_hold": "150min",
   "cisd": "series_open 2/2 max_wait 3",
   "grid4h": "forex"
  }
 },
