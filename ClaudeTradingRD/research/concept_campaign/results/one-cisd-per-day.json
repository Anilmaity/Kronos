  "swing": "phase3: locked 2/2 swing",
  "window": "session_window_fit: London open 02:00 NY .. ny_am end 12:00 NY (concept names London then New York)",
  "day_end": "session_window_fit: daily halt 17:00 NY ends the trading day",
