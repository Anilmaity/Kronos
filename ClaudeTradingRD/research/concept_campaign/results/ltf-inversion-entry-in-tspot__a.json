 "claim": "+",
 "operationalization": {
  "rules": [
   "C2 (1h): low < prior low and close > prior low (bullish; bearish mirror); C3 = the next 1h bar opening at C2's close",
   "alignment: a 5m CISD (series_open, 2/2, max_wait 3) in the model direction confirmed inside C2 (start >= C2 open, confirm bar close <= C2 close)",
   "T-spot (declared stand-in, derivation withheld): [C2 low, C2 EQ] for bullish ([C2 EQ, C2 high] bearish); tagged when a C3 M1 bar trades to the EQ; invalid once C3 trades beyond C2's extreme",
   "inversion (1m): a bearish 1m FVG formed inside C3 whose zone overlaps the T-spot, then a later 1m CLOSE above its top (whole gap) after the T-spot was tagged; decide at that close, enter next M1 open",
   "stop = the wick extreme of C3 so far (the swing that formed the wick)",
   "reading a: target 2R, max hold 5h"
  ],
  "params": {
   "stack": "1h/5m/1m",
   "tspot": "C2 wick-side half [extreme, EQ]",
   "rr": 2.0,
   "max_hold": "5h",
   "cisd": "series_open 2/2 max_wait 3",
   "ctrl_tod_tol_min": 30
  }
 },
