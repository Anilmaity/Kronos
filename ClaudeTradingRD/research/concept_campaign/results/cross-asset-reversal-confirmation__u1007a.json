 "operationalization": {
  "rules": [
   "pair: gold (traded) vs silver XAG_USD H1 (OANDA), silver bars closed by the decision only",
   "strength = % change from the 18:00-NY trading-day open to the latest closed 1h bar",
   "baseline: phase-3 bare 1h gold CISD (series_open, swing 2/2, max_wait 3), stop protected swing, 2R, 10h; kept when gold long & gold stronger, or gold short & gold weaker",
   "sample: silver reversed in (t-3h, t]: shallow or deep form (below)",
   "shallow ('another sweep'): silver 1h bar took the latest confirmed 2/2 swing low, closed back above it, low stayed >= prior 20-bar low (mirror highs for shorts)",
   "deep ('all the way to the deeper low'): silver bar took the prior 20-bar low and closed back above it; if both forms occur in the window the event counts as deep",
   "gate = shallow; complement = deep; claim '+' (shallow form better)",
   "untested parts: 5m closure (no silver 5m data), proximity-tell (needs >=3 correlates), fresh-SMT condition not separately required"
  ],
  "params": {
   "tf": "1h",
   "level_rule": "series_open",
   "swing": "2/2",
   "max_wait": 3,
   "rr": 2.0,
