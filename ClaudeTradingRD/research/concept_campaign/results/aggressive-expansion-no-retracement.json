 "claim": "+",
 "operationalization": {
  "rules": [
   "15min bars; live short-term high = latest fractal 2/2 swing high confirmed before the bar; break = first CLOSE above it (mirror for lows)",
   "window = 4 candles from the break bar; decide at the close of its last candle",
   "aggressive := win_range/pre_range >= 1.5 AND (window extreme - level)/pre_range >= 0.65 (pre_range = the 4 candles before the break)",
   "enter next M1 open in the break direction; stop = 50% retracement of the impulse leg (lowest low from the swing bar to the window end -> window high); skip if the window already closed beyond it; target 1.0R; exit after 150min",
   "gate_test: aggressive breaks vs the rest, control-adjusted R, claim '+'"
  ],
  "params": {
   "tf": "15min",
   "window_n": 4,
   "r_cut": 1.5,
   "d_cut": 0.65,
   "swing": "fractal 2/2",
   "shallow_cut": 0.5,
   "rr": 1.0,
   "max_hold": "150min"
  }
 },
