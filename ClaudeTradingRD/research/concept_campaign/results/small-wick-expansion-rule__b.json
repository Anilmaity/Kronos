 "operationalization": {
  "rules": [
   "every closed 4H candle (forex grid 17/21/01/05/09/13 NY) with close != open",
   "trade the continuation: decide at its close, enter next M1 open in its direction, stop at its opposite extreme, no target, exit after 240 M1 bars",
   "opposing run = open -> extreme against the candle's direction",
   "gate: opposing_run / (high-low) <= 0.30"
  ],
  "params": {
   "tf": "4h",
   "grid4h": "forex",
   "max_hold": "240min",
   "hold_basis": "bars",
   "target": "none (time exit)",
   "wick_cut_range": 0.3
  }
 },
