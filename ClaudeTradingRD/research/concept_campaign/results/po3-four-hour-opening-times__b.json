 "operationalization": {
  "rules": [
   "4H bars on the forex grid (New York, DST-aware)",
   "C2 = the 05:00 candle vs the contiguous 01:00 candle: bullish low<prev low & close>prev low; bearish high>prev high & close<prev high; two-sided skipped",
   "decide at the C2 close (09:00 NY), enter next M1 open in the reversal direction (the 09:00 candle-3 continuation)",
   "stop = C2 wick extreme; target 2R; exit after 4h (end of the continuation candle)"
  ],
  "params": {
   "grid4h": "forex",
   "c2_candle": "05:00",
   "continuation_candle": "09:00",
   "rr": 2.0,
   "stop": "C2 extreme",
   "max_hold": "4h"
  }
 },
