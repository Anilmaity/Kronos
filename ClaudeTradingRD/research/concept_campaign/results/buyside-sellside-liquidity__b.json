 "operationalization": {
  "rules": [
   "pools := untaken 15m fractal-2/2 swing highs/lows, usable from the bar after confirmation, tracked for 7 days after the swing bar",
   "sweep := a 15m bar trades through >=1 untaken pool on one side (not both) and closes back beyond ALL pools it took",
   "entry: opposite direction at the next M1 open after that bar's close",
   "stop: the sweep bar's extreme; target: nearest untaken opposite pool beyond the close; time exit after 6h of trading time"
  ],
  "params": {
   "tf": "15min",
   "left": 2,
   "right": 2,
   "pool_window": "7D",
   "max_hold": "6h",
   "hold_basis": "bars",
   "ctrl_tod_tol_min": 30
  }
 },
