{
 "concept_id": "no-news-judas-swing",
 "reading": null,
 "testable": true,
 "test_type": "gate",
 "claim": "+",
 "operationalization": {
  "rules": [
   "each NY trading day: Judas leg = M1 bars 09:30-09:44 NY (>= 10 present); direction = opposite sign(09:44 close - 09:30 open); decide 09:45 NY, enter the next M1 open",
   "stop at the Judas leg's extreme on the move side (its high for a short, low for a long); target 2R; time exit 375 min (16:00 NY)",
   "gate (pass) = no-news day; news day = derived NFP Friday OR 08:30 NY 5m candle range >= 3x the median range of the prior 288 5m bars (known 08:35 NY)",
   "claim '+': the 09:30 fade does better on no-news days than on news days"
  ],
  "params": {
   "judas_min": 15,
   "min_cover": 10,
   "rr": 2.0,
   "max_hold": "375min",
   "spike_mult": 3.0,
   "median_bars": 288,
   "nfp_rule": "BLS reference-week rule"
  }
 },
 "params_source": {
  "judas_min": "declared-before-run: the corpus gives no duration for the swing; first 15 minutes (three 5m bars) off 09:30",
  "min_cover": "declared-before-run: 2/3 of the leg's M1 bars present",
  "rr": "declared-before-run: no target size stated ('opposite end of the range'); 2R as in the phase-3 books",
  "max_hold": "corpus: concept measurable 'range of the 09:30-to-close leg' -> exit 16:00 NY",
  "spike_mult": "declared-before-run: same 3x 08:30 footprint proxy as entry_own_04a/ignore-news-wick-in-range-fib",
  "median_bars": "declared-before-run: prior 24h of 5m bars (288)",
  "nfp_rule": "declared-before-run: BLS Employment Situation schedule (as risk_guest_02b/pre-event-avoidance-rule)"
