 "testable": true,
 "test_type": "gate",
 "claim": "+",
 "operationalization": {
  "rules": [
   "baseline: 5m bare CISD (series_open, 2/2 swings, max_wait 3), decide at the confirming 5m close, enter next M1 open, stop = protected swing, 2R, 50 min exit; only decisions in [09:30, 10:30) New York",
   "9:30 move = direction of the first 5m candle 09:30-09:35 (doji = no move)",
   "continuation = first later 5m candle (closing 09:40..09:55) whose close is beyond the 9:30 candle's high (up move) / low (down move)",
   "gate (permitted): decision >= 10:00, or decision at/after the continuation close",
   "complement (forbidden, 'chopped'): decisions in [09:30, 10:00) with no continuation yet (09:30 and 09:35 always)",
   "rows in [09:40, 10:00) on a date with no 09:30 5m candle are dropped"
  ],
  "params": {
   "baseline_tf": "5min",
   "cisd": {
    "level_rule": "series_open",
    "left": 2,
    "right": 2,
    "max_wait": 3,
    "min_series": 1
   },
   "rr": 2.0,
   "max_hold": "50min",
   "band": [
    [
     "09:30",
     "10:30"
    ]
   ],
   "deadline": "10:00",
   "tz": "America/New_York",
   "move_bar": "5min 09:30-09:35",
   "continuation": "5m close beyond the 9:30 candle's extreme, before 10:00"
  }
 },
 "params_source": {
  "baseline_tf": "declared-before-run: 5m CISD book = finest phase-3 locked stack; corpus LTF for the NY window is 15m/5m (entry-time-window timeframes.ltf)",
  "cisd": "phase3: locked CISD config (conjunction_preregistration 1.8-1.13: series_open, 2/2, max_wait 3)",
  "rr": "phase3: 2R target (conjunction_preregistration locked config)",
  "max_hold": "phase3: 10 entry-TF bars (conjunction_preregistration 1.13) = 50 min on 5m",
  "band": "declared-before-run: same band as entry-time-window u1007b ([09:30,10:30), equal 30-min arm after 10:00) so only the conditional element changes; corpus: rTomJ8URFnw 'Wait for 10:00 a.m.'",
  "deadline": "corpus: rTomJ8URFnw 'If you still don't, wait for 10:00 a.m.'",
  "tz": "session_window_fit: America/New_York with DST (settled, 99.8% of 605 daily breaks resume at 18:00 NY)",
  "move_bar": "corpus: rTomJ8URFnw 'most people are probably better off waiting 5 minutes' (the 9:30 move is read on the first 5m close)",
  "continuation": "corpus: rTomJ8URFnw 'If 9:30 move doesn't get a continuation, it's chopped.'; threshold_fits: structural displacement = candle closes beyond the reference level (hard gate, grade A)"
